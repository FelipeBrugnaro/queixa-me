APP_NAME="queixa.me"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Lisbon
APP_URL=http://localhost:8000

# Domínio canónico usado em sitemaps, canonicals e Open Graph
APP_CANONICAL_URL=https://queixa.me

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev: SQLite (zero configuração). Produção: MySQL 8 / MariaDB (ver .env.example)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@queixa.me"
MAIL_FROM_NAME="${APP_NAME}"

# --- queixa.me ---
# Versões dos documentos legais aceites (registadas em cada consentimento)
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_VERSION=1.0
LEGAL_DATA_PROTECTION_VERSION=1.0

# Idade mínima para criar conta (RGPD art. 8 - Portugal: 16 anos)
QM_MINIMUM_AGE=16

# Login social (opcional - deixar vazio desativa o botão)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

VITE_APP_NAME="${APP_NAME}"

# --- Produção (MySQL) ---
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=queixame
# DB_USERNAME=queixame
# DB_PASSWORD=
